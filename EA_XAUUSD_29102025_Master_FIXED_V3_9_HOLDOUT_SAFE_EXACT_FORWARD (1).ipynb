    "\n",
    "# âœ… Optimization Parameter Ranges\n",
    "indicator_params = {\n",
    "    'EMA': {\n",
    "        'fast': list(range(5, 26, 5)),       # 5 to 25 step 5\n",
    "        'slow': list(range(30, 201, 20))     # 30 to 200 step 20\n",
    "    },\n",
    "    'RSI': {\n",
    "        'period': list(range(7, 22, 2)),               # 7 to 21 step 2\n",
